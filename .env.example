# SecureCodeOps AI Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./securecodeops.db
SYNC_DATABASE_URL=sqlite:///./securecodeops.db

# Storage Directories
UPLOAD_DIR=./storage/uploads
SANDBOX_DIR=./storage/sandboxes
REPORTS_DIR=./storage/reports

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_COUNT=2000
MAX_TOTAL_UNCOMPRESSED_SIZE_MB=200

# LLM Provider Configuration ("offline", "openai", "gemini", "anthropic")
LLM_PROVIDER=offline
MODEL_NAME=offline-rule-engine-v1

# Cloud LLM API Keys (Optional - only if LLM_PROVIDER is set to cloud)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Security
SECRET_KEY=securecodeops-dev-secret-key-change-in-prod-2026
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "*"]

# Scanner Integrations
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_TRIVY=true
ENABLE_GITLEAKS=true
